<Window x:Class="CodexSlotPing.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CodexSlotPing.App.Localization"
        Title="Codex Slot Ping"
        Width="430"
        Height="700"
        MinWidth="400"
        MinHeight="620"
        Background="#F6F5F1"
        Foreground="#222522"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="CanMinimize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#68706A" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#C9CEC8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FBFAF7" />
            <Setter Property="Foreground" Value="#26302A" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ShortcutRow" TargetType="Button">
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#ECEFEA" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#ECEFEA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,20">
            <TextBlock Text="CODEX SLOT PING" FontSize="11" FontWeight="Bold" Foreground="#3C7657" />
            <TextBlock Text="Codex Slot Ping" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,18" />

            <TextBlock Text="{loc:Loc Main.CodexHeader}" Style="{StaticResource SectionLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                <TextBlock x:Name="ConnectionDot" Text="●" Foreground="#31845B" FontSize="15" Margin="0,0,8,0" />
                <TextBlock x:Name="ConnectionStatusText" Text="{loc:Loc Main.ConnectionChecking}" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="LoginStatusText" Text="" Foreground="#606962" Margin="22,0,0,2" />
            <TextBlock x:Name="VersionText" Text="" Foreground="#818780" Margin="22,0,0,0" />
            <Button x:Name="UpdateBannerButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                    Visibility="Collapsed" Margin="22,5,0,0" Click="UpdateBanner_Click" />
            <TextBlock x:Name="UpdateNoticeText" Text="" Foreground="#3C7657" TextWrapping="Wrap"
                       Margin="22,5,0,0" Visibility="Collapsed" />

            <Border Height="1" Background="#D8DAD4" Margin="0,18,0,16" />

            <TextBlock Text="{loc:Loc Main.NextSlot}" Style="{StaticResource SectionLabel}" />
            <TextBlock x:Name="NextSlotTimeText" Text="—" FontSize="34" FontWeight="Light" Margin="0,3,0,0" />
            <TextBlock x:Name="NextSlotCountdownText" Text="{loc:Loc Main.WaitingForSchedule}" FontSize="13" Foreground="#68706A" Margin="0,0,0,12" />

            <TextBlock Text="{loc:Loc Main.Today}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
            <ItemsControl x:Name="TodayRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" FontFamily="Consolas" Foreground="#424A44" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#424A44" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="#D8DAD4" Margin="0,14,0,12" />
            <TextBlock Text="{loc:Loc Main.EligibilityTitle}" Style="{StaticResource SectionLabel}" />
            <TextBlock x:Name="EligibilityDetailsText" Text="—" TextWrapping="Wrap" Foreground="#424A44" Margin="0,6,0,0" />

            <Border Height="1" Background="#D8DAD4" Margin="0,14,0,12" />

            <Button Style="{StaticResource ShortcutRow}" Click="OpenSettingsShortcut_Click" ToolTip="{loc:Loc Main.OpenSettingHint}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Main.Model}" Foreground="#68706A" />
                    <TextBlock x:Name="ModelText" Grid.Column="1" Text="—" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="›" Foreground="#7D837D" HorizontalAlignment="Right" />
                </Grid>
            </Button>
            <Button Style="{StaticResource ShortcutRow}" Click="OpenSettingsShortcut_Click" ToolTip="{loc:Loc Main.OpenSettingHint}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Main.Reasoning}" Foreground="#68706A" />
                    <TextBlock x:Name="ReasoningText" Grid.Column="1" Text="—" />
                    <TextBlock Grid.Column="2" Text="›" Foreground="#7D837D" HorizontalAlignment="Right" />
                </Grid>
            </Button>
            <Button Style="{StaticResource ShortcutRow}" Click="OpenSettingsShortcut_Click" ToolTip="{loc:Loc Main.OpenSettingHint}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Main.Scheduler}" Foreground="#68706A" />
                    <TextBlock x:Name="SchedulerText" Grid.Column="1" Text="—" FontWeight="Medium" />
                    <TextBlock Grid.Column="2" Text="›" Foreground="#7D837D" HorizontalAlignment="Right" />
                </Grid>
            </Button>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Main.AutomationControl}" Foreground="#68706A" />
                <TextBlock x:Name="AutomationStatusText" Grid.Column="1" Text="—" FontWeight="Medium" />
            </Grid>
            <Button Style="{StaticResource ShortcutRow}" Click="OpenSettingsShortcut_Click" ToolTip="{loc:Loc Main.OpenSettingHint}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Main.WakeComputer}" Foreground="#68706A" />
                    <TextBlock x:Name="WakeText" Grid.Column="1" Text="—" />
                    <TextBlock Grid.Column="2" Text="›" Foreground="#7D837D" HorizontalAlignment="Right" />
                </Grid>
            </Button>

            <TextBlock x:Name="StatusMessageText" Text="" TextWrapping="Wrap" Foreground="#8A4C24" Margin="0,12,0,0" />
            <TextBox x:Name="EnvironmentInstructionsText"
                     Visibility="Collapsed"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Background="#EEEDE7"
                     BorderThickness="0"
                     Padding="8"
                     Margin="0,8,0,0" />
            <Button x:Name="CopyInstructionsButton" Content="{loc:Loc Main.CopyInstructions}" Style="{StaticResource QuietButton}"
                    Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,7,0,0" Click="CopyInstructions_Click" />
            <Button x:Name="TimezoneActionButton" Content="{loc:Loc Main.TimezoneAction}"
                    Style="{StaticResource QuietButton}" Visibility="Collapsed" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Click="TimezoneAction_Click" />

            <WrapPanel Margin="0,18,0,0">
                <Button x:Name="TestNowButton" Content="{loc:Loc Main.TestNow}" Style="{StaticResource QuietButton}" Click="TestNow_Click" />
                <Button x:Name="AutomationPauseButton" Content="{loc:Loc Automation.Pause}" Style="{StaticResource QuietButton}" Click="ToggleAutomation_Click" />
                <Button x:Name="SettingsButton" Content="{loc:Loc Main.Settings}" Style="{StaticResource QuietButton}" Click="Settings_Click" />
                <Button x:Name="OpenLogsButton" Content="{loc:Loc Main.OpenLogs}" Style="{StaticResource QuietButton}" Click="OpenLogs_Click" />
            </WrapPanel>
            <TextBlock Text="{loc:Loc Main.StrictSlot}" FontSize="11" Foreground="#7D837D" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
