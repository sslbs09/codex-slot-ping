<Window x:Class="CodexSlotPing.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Slot Ping"
        Width="430"
        Height="700"
        MinWidth="400"
        MinHeight="620"
        Background="#F6F5F1"
        Foreground="#222522"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="CanMinimize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#68706A" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#C9CEC8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FBFAF7" />
            <Setter Property="Foreground" Value="#26302A" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,20">
            <TextBlock Text="CODEX SLOT PING" FontSize="11" FontWeight="Bold" Foreground="#3C7657" />
            <TextBlock Text="Codex Slot Ping" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,18" />

            <TextBlock Text="CODEX" Style="{StaticResource SectionLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                <TextBlock x:Name="ConnectionDot" Text="●" Foreground="#31845B" FontSize="15" Margin="0,0,8,0" />
                <TextBlock x:Name="ConnectionStatusText" Text="Checking connection…" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="LoginStatusText" Text="" Foreground="#606962" Margin="22,0,0,2" />
            <TextBlock x:Name="VersionText" Text="" Foreground="#818780" Margin="22,0,0,0" />

            <Border Height="1" Background="#D8DAD4" Margin="0,18,0,16" />

            <TextBlock Text="NEXT SLOT" Style="{StaticResource SectionLabel}" />
            <TextBlock x:Name="NextSlotTimeText" Text="—" FontSize="34" FontWeight="Light" Margin="0,3,0,0" />
            <TextBlock x:Name="NextSlotCountdownText" Text="Waiting for schedule" FontSize="13" Foreground="#68706A" Margin="0,0,0,12" />

            <TextBlock Text="TODAY" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
            <ItemsControl x:Name="TodayRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Time}" FontFamily="Consolas" Foreground="#424A44" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#424A44" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Background="#D8DAD4" Margin="0,14,0,12" />

            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Model" Foreground="#68706A" />
                <TextBlock x:Name="ModelText" Grid.Column="1" Text="—" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Reasoning" Foreground="#68706A" />
                <TextBlock x:Name="ReasoningText" Grid.Column="1" Text="—" />
            </Grid>
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scheduler" Foreground="#68706A" />
                <TextBlock x:Name="SchedulerText" Grid.Column="1" Text="—" FontWeight="Medium" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Wake computer" Foreground="#68706A" />
                <TextBlock x:Name="WakeText" Grid.Column="1" Text="—" />
            </Grid>

            <TextBlock x:Name="StatusMessageText" Text="" TextWrapping="Wrap" Foreground="#8A4C24" Margin="0,12,0,0" />
            <TextBox x:Name="EnvironmentInstructionsText"
                     Visibility="Collapsed"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Background="#EEEDE7"
                     BorderThickness="0"
                     Padding="8"
                     Margin="0,8,0,0" />
            <Button x:Name="CopyInstructionsButton" Content="Copy instructions" Style="{StaticResource QuietButton}"
                    Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,7,0,0" Click="CopyInstructions_Click" />
            <Button x:Name="TimezoneActionButton" Content="Use current timezone and update scheduler"
                    Style="{StaticResource QuietButton}" Visibility="Collapsed" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Click="TimezoneAction_Click" />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button x:Name="TestNowButton" Content="Test now" Style="{StaticResource QuietButton}" Click="TestNow_Click" />
                <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource QuietButton}" Click="Settings_Click" />
                <Button x:Name="OpenLogsButton" Content="Open logs" Style="{StaticResource QuietButton}" Click="OpenLogs_Click" />
            </StackPanel>
            <TextBlock Text="Strict slot · missed slots are not replayed." FontSize="11" Foreground="#7D837D" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
