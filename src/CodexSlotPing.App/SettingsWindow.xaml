<Window x:Class="CodexSlotPing.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CodexSlotPing.App.Localization"
        Title="{loc:Loc Settings.WindowTitle}"
        Width="500"
        Height="760"
        MinWidth="460"
        MinHeight="660"
        Background="#F6F5F1"
        Foreground="#222522"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#58615A" />
            <Setter Property="Margin" Value="0,8,0,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#C9CEC8" />
            <Setter Property="Background" Value="#FBFAF7" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="BorderBrush" Value="#C9CEC8" />
            <Setter Property="Background" Value="#FBFAF7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,20">
            <TextBlock Text="{loc:Loc Settings.Header}" FontSize="11" FontWeight="Bold" Foreground="#3C7657" />
            <TextBlock Text="{loc:Loc Settings.SectionTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,10" />

            <TextBlock Text="{loc:Loc Settings.FourLocalTimes}" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Slot1Text" Style="{StaticResource FieldInput}" Margin="0,0,6,0" />
                <TextBox x:Name="Slot2Text" Grid.Column="1" Style="{StaticResource FieldInput}" Margin="0,0,6,0" />
                <TextBox x:Name="Slot3Text" Grid.Column="2" Style="{StaticResource FieldInput}" Margin="0,0,6,0" />
                <TextBox x:Name="Slot4Text" Grid.Column="3" Style="{StaticResource FieldInput}" />
            </Grid>

            <TextBlock Text="{loc:Loc Settings.ModelRequest}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ModelText" Style="{StaticResource FieldInput}" />
            <TextBlock Text="{loc:Loc Settings.ReasoningSupport}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ReasoningCombo" Padding="7,5" Background="#FBFAF7" BorderBrush="#C9CEC8" />

            <TextBlock Text="{loc:Loc Settings.PromptLabel}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="PromptText" Style="{StaticResource FieldInput}" MinHeight="72"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <TextBlock Text="{loc:Loc Settings.TimezoneBehavior}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TimeZoneCombo" Padding="7,5" Background="#FBFAF7" BorderBrush="#C9CEC8" />
            <TextBlock Text="{loc:Loc Settings.SystemTimezoneDescription}" FontSize="11"
                       Foreground="#7A817B" TextWrapping="Wrap" Margin="0,4,0,0" />
            <Button x:Name="TimezoneUpdateButton" Content="{loc:Loc Settings.ConfirmTimezone}"
                    Style="{StaticResource ActionButton}" Visibility="Collapsed" HorizontalAlignment="Left"
                    Margin="0,7,0,0" Click="TimezoneUpdate_Click" />

            <CheckBox x:Name="WakeCheck" Content="{loc:Loc Settings.WakeComputer}" Margin="0,14,0,0" />
            <CheckBox x:Name="RawLogsCheck" Content="{loc:Loc Settings.RawLogs}"
                      Margin="0,10,0,0" Checked="RawLogs_Checked" Unchecked="RawLogs_Unchecked" />
            <TextBlock Text="{loc:Loc Settings.RawLogsExplanation}"
                       FontSize="11" Foreground="#7A817B" TextWrapping="Wrap" Margin="21,3,0,0" />

            <TextBlock Text="{loc:Loc Main.EligibilityTitle}" Style="{StaticResource FieldLabel}" Margin="0,15,0,4" />
            <TextBlock x:Name="EligibilityDetailsText" Text="—" TextWrapping="Wrap" Foreground="#424A44" />

            <TextBlock Text="{loc:Loc Main.AutomationControl}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBlock x:Name="AutomationStatusText" Text="—" Foreground="#424A44" />
            <TextBlock Text="{loc:Loc Main.Scheduler}" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
            <TextBlock x:Name="SchedulerStatusText" Text="—" Foreground="#424A44" />

            <TextBlock Text="{loc:Loc Settings.UpdateSectionTitle}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <Button x:Name="CheckForUpdatesButton" Content="{loc:Loc Settings.CheckForUpdates}"
                    Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,3,0,4"
                    Click="CheckForUpdates_Click" />
            <Button x:Name="DownloadUpdateButton" Content="{loc:Loc Settings.DownloadUpdate}"
                    Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,3,0,4"
                    Visibility="Collapsed" Click="DownloadUpdate_Click" />
            <Button x:Name="InstallUpdateButton" Content="{loc:Loc Update.InstallAndRestart}"
                    Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,3,0,4"
                    Visibility="Collapsed" Click="InstallUpdate_Click" />
            <TextBlock x:Name="UpdateStatusText" Text="—" Foreground="#424A44" TextWrapping="Wrap" />
            <TextBlock x:Name="UpdateReleaseText" TextWrapping="Wrap" Foreground="#58615A" Margin="0,5,0,0" />
            <TextBlock x:Name="UpdateReleaseUrlText" TextWrapping="Wrap" Foreground="#58615A" Margin="0,4,0,0" />
            <TextBlock x:Name="UpdateAssetText" TextWrapping="Wrap" Foreground="#58615A" Margin="0,4,0,0" />

            <TextBlock x:Name="StatusText" Text="" Foreground="#8A4C24" TextWrapping="Wrap" Margin="0,14,0,8" />
            <WrapPanel>
                <Button x:Name="AutomationPauseButton" Content="{loc:Loc Automation.Pause}" Style="{StaticResource ActionButton}" Click="AutomationPause_Click" />
                <Button Content="{loc:Loc Settings.Save}" Style="{StaticResource ActionButton}" Click="Save_Click" />
                <Button Content="{loc:Loc Settings.InstallScheduler}" Style="{StaticResource ActionButton}" Click="Install_Click" />
                <Button Content="{loc:Loc Settings.DisableScheduler}" Style="{StaticResource ActionButton}" Click="Disable_Click" />
                <Button Content="{loc:Loc Settings.RemoveScheduler}" Style="{StaticResource ActionButton}" Click="Remove_Click" />
                <Button Content="{loc:Loc Settings.Close}" Style="{StaticResource ActionButton}" Click="Close_Click" />
            </WrapPanel>
            <TextBlock Text="{loc:Loc Settings.SchedulerWarning}"
                       FontSize="11" Foreground="#7A817B" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
