<Window x:Class="CodexSlotPing.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Slot Ping settings"
        Width="500"
        Height="760"
        MinWidth="460"
        MinHeight="660"
        Background="#F6F5F1"
        Foreground="#222522"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#58615A" />
            <Setter Property="Margin" Value="0,8,0,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#C9CEC8" />
            <Setter Property="Background" Value="#FBFAF7" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="BorderBrush" Value="#C9CEC8" />
            <Setter Property="Background" Value="#FBFAF7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,20">
            <TextBlock Text="SETTINGS" FontSize="11" FontWeight="Bold" Foreground="#3C7657" />
            <TextBlock Text="Schedule and request" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,10" />

            <TextBlock Text="Four local times (24-hour HH:mm)" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Slot1Text" Style="{StaticResource FieldInput}" Margin="0,0,6,0" />
                <TextBox x:Name="Slot2Text" Grid.Column="1" Style="{StaticResource FieldInput}" Margin="0,0,6,0" />
                <TextBox x:Name="Slot3Text" Grid.Column="2" Style="{StaticResource FieldInput}" Margin="0,0,6,0" />
                <TextBox x:Name="Slot4Text" Grid.Column="3" Style="{StaticResource FieldInput}" />
            </Grid>

            <TextBlock Text="Model selection request" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ModelText" Style="{StaticResource FieldInput}" />
            <TextBlock Text="Reasoning effort supported by the detected CLI" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ReasoningCombo" Padding="7,5" Background="#FBFAF7" BorderBrush="#C9CEC8" />

            <TextBlock Text="Prompt sent at each formal slot and by Test Now" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="PromptText" Style="{StaticResource FieldInput}" MinHeight="72"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <TextBlock Text="Timezone behavior" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="TimeZoneCombo" Padding="7,5" Background="#FBFAF7" BorderBrush="#C9CEC8" />
            <TextBlock Text="SYSTEM follows Windows. A timezone lock must match the current Windows timezone." FontSize="11"
                       Foreground="#7A817B" TextWrapping="Wrap" Margin="0,4,0,0" />
            <Button x:Name="TimezoneUpdateButton" Content="Confirm current timezone and update scheduler"
                    Style="{StaticResource ActionButton}" Visibility="Collapsed" HorizontalAlignment="Left"
                    Margin="0,7,0,0" Click="TimezoneUpdate_Click" />

            <CheckBox x:Name="WakeCheck" Content="Wake the computer for scheduled slots" Margin="0,14,0,0" />
            <CheckBox x:Name="RawLogsCheck" Content="Capture raw Codex output locally (14-day retention)"
                      Margin="0,10,0,0" Checked="RawLogs_Checked" Unchecked="RawLogs_Unchecked" />
            <TextBlock Text="Raw output can contain Codex responses. It stays in your local logs folder and is removed after 14 days."
                       FontSize="11" Foreground="#7A817B" TextWrapping="Wrap" Margin="21,3,0,0" />

            <TextBlock x:Name="StatusText" Text="" Foreground="#8A4C24" TextWrapping="Wrap" Margin="0,14,0,8" />
            <WrapPanel>
                <Button Content="Save settings" Style="{StaticResource ActionButton}" Click="Save_Click" />
                <Button Content="Install / update scheduler" Style="{StaticResource ActionButton}" Click="Install_Click" />
                <Button Content="Disable scheduler" Style="{StaticResource ActionButton}" Click="Disable_Click" />
                <Button Content="Remove scheduler" Style="{StaticResource ActionButton}" Click="Remove_Click" />
                <Button Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click" />
            </WrapPanel>
            <TextBlock Text="Installing enables four local-time triggers. Each eligible trigger can send the configured prompt to Codex and may count toward usage."
                       FontSize="11" Foreground="#7A817B" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
